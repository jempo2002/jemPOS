# PLANTILLA. Copia este archivo a .env y rellena los valores reales.
#
# Este archivo SI se sube a git: es la referencia de que variables hace falta
# definir. Por eso NUNCA debe llevar un valor real. Deja siempre la clave con
# el signo igual y nada detras.
#
# El .env de verdad esta en .gitignore y no se sube nunca.

SECRET_KEY=

DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

# filesystem en local. Ver nota de despliegue: con varias instancias hace falta
# un backend compartido (redis) o las sesiones se pierden al balancear.
SESSION_TYPE=

# Entorno de ejecucion. Con 'development' (o FLASK_DEBUG=1) NO se fuerza HTTPS,
# para poder trabajar en http://127.0.0.1:5000. Si esta vacio o dice otra cosa
# se asume produccion: Flask-Talisman redirige a HTTPS, manda HSTS y marca la
# cookie de sesion como Secure. Ver app/security.py
FLASK_ENV=

# Correo de recuperacion de contrasena y alertas de respaldo.
# EMAIL_PASSWORD debe ser una "contrasena de aplicacion" de Google, no la
# contrasena de la cuenta: Gmail rechaza la contrasena normal por SMTP y una
# contrasena de aplicacion se puede revocar sola si se filtra.
EMAIL_SENDER=
EMAIL_PASSWORD=
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
BACKUP_ALERT_EMAIL=

# Carpeta opcional para errores de correo.
LOG_DIR=logs

# Almacen de Flask-Limiter. Vacio = memory:// (cuenta por worker y se pierde al
# reiniciar). En produccion con varios workers: redis://host:6379/0
RATELIMIT_STORAGE_URI=

# SEO y analitica. Vacios = no se inyecta nada en el HTML.
# GA_MEASUREMENT_ID: ID de flujo web de Google Analytics 4 (formato G-XXXXXXXXXX).
#   Solo carga en paginas publicas y despues de que el visitante acepta cookies.
#   Al activarlo, revisa la politica de privacidad (seccion 5 y 6 cambian solas).
# GOOGLE_SITE_VERIFICATION: solo el valor content="..." de la etiqueta meta que
#   da Search Console (metodo "Etiqueta HTML"), sin la etiqueta.
GA_MEASUREMENT_ID=
GOOGLE_SITE_VERIFICATION=
